{
  "log": {
    "loglevel": "warning"
  },
  "inbounds": [
    {
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "port": 10808,
      "protocol": "mixed",
      "settings": {
        "udp": true
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls",
          "quic"
        ],
        "routeOnly": true
      }
    }
  ],
  "outbounds": [
    {
      "tag": "SERVER-1-VMESS",
      "protocol": "vmess",
      "settings": {
        "vnext": [
          {
            "address": "renderer-stream-1-505.mirracloud.io",
            "port": 443,
            "users": [
              {
                "id": "b8a8d84a-56d0-4bd0-a8a5-b6d674216719",
                "alterId": 0,
                "security": "auto",
                "level": 0
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "ws",
        "security": "tls",
        "tlsSettings": {
          "serverName": "renderer-stream-1-505.mirracloud.io",
          "fingerprint": "firefox"
        },
        "wsSettings": {
          "path": "/api/v1/gpu-stream/socket",
          "headers": {
            "Host": "renderer-stream-1-505.mirracloud.io"
          }
        }
      }
    },
    {
      "tag": "SERVER-2-VLESS",
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "cdn4.el-bot.com",
            "port": 443,
            "users": [
              {
                "id": "9c8be6d4-ea6d-45e1-a6e3-13546b018fa0",
                "encryption": "none"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "xhttp",
        "security": "tls",
        "tlsSettings": {
          "serverName": "cdn4.el-bot.com",
          "fingerprint": "firefox",
          "alpn": [
            "h2"
          ]
        },
        "xhttpSettings": {
          "host": "cdn4.el-bot.com",
          "path": "/p"
        }
      },
      "proxySettings": {
        "tag": "SERVER-1-VMESS",
        "transportLayer": true
      }
    },
    {
      "tag": "direct",
      "protocol": "freedom"
    },
    {
      "tag": "block",
      "protocol": "blackhole"
    }
  ],
  "routing": {
    "domainStrategy": "AsIs",
    "rules": [
      {
        "type": "field",
        "inboundTag": [
          "mixed-in"
        ],
        "outboundTag": "SERVER-2-VLESS"
      }
    ]
  }
}
