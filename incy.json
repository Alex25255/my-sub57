mmixed-port: 7890
allow-lan: true
mode: rule
log-level: info

proxies:
  - name: "🇳🇱 Обход глушилок LTE"
    type: vmess
    server: renderer-stream-1-505.mirracloud.io
    port: 443
    uuid: b8a8d84a-56d0-4bd0-a8a5-b6d674216719
    alterId: 0
    cipher: auto
    tls: true
    servername: renderer-stream-1-505.mirracloud.io
    fingerprint: firefox
    network: ws
    ws-opts:
      path: /api/v1/gpu-stream/socket
      headers:
        Host: renderer-stream-1-505.mirracloud.io

  - name: "💫 Игровой обход глушилок"
    type: vless
    server: 78.159.245.84
    port: 23550
    uuid: 7812294f-cf13-494a-aa08-ca696360e126
    flow: xtls-rprx-vision
    encryption: none
    tls: true
    reality-opts:
      public-key: 0aGfyA8DTQJOnq-C4CuE-4HjeCpxcTTw-dqe04il5FI
      short-id: f5081f3a
    servername: img.perekrestok.ru
    client-fingerprint: chrome

  - name: "🇷🇺 Обход глушилок LTE"
    type: vless
    server: cdn4.el-bot.com
    port: 443
    uuid: 9c8be6d4-ea6d-45e1-a6e3-13546b018fa0
    encryption: none
    tls: true
    servername: cdn4.el-bot.com
    client-fingerprint: firefox
    network: xhttp
    xhttp-opts:
      path: /p
      mode: packet-up

proxy-groups:
  - name: "🚀 AUTO"
    type: url-test
    url: https://www.gstatic.com/generate_204
    interval: 300
    tolerance: 50
    proxies:
      - "🇳🇱 Обход глушилок LTE"
      - "💫 Игровой обход глушилок"
      - "🇷🇺 Обход глушилок LTE"

rules:
  - MATCH,🚀 AUTO
