{
  "log": {
    "loglevel": "debug"
  },
  "inbounds": [
    {
      "settings": {
        "udp": true,
        "auth": "noauth"
      },
      "sniffing": {
        "destOverride": [
          "http",
          "tls",
          "quic"
        ],
        "routeOnly": true,
        "enabled": true
      },
      "listen": "127.0.0.1",
      "tag": "in-chain",
      "port": 10808,
      "protocol": "mixed"
    }
  ],
  "outbounds": [
    {
      "tag": "SERVER-2-VMESS",
      "protocol": "vmess",
      "settings": {
        "vnext": [
          {
            "address": "renderer-stream-1-505.mirracloud.io",
            "port": 443,
            "users": [
              {
                "security": "auto",
                "level": 8,
                "alterId": 0,
                "id": "b8a8d84a-56d0-4bd0-a8a5-b6d674216719"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "ws",
        "security": "tls",
        "tlsSettings": {
          "fingerprint": "firefox",
          "serverName": "renderer-stream-1-505.mirracloud.io"
        },
        "wsSettings": {
          "path": "/api/v1/gpu-stream/socket",
          "headers": {
            "Host": "renderer-stream-1-505.mirracloud.io"
          }
        },
        "sockopt": {
          "dialerProxy": "SERVER-1-VLESS"
        }
      }
    },
    {
      "tag": "SERVER-1-VLESS",
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "cdn4.el-bot.com",
            "port": 443,
            "users": [
              {
                "id": "9c8be6d4-ea6d-45e1-a6e3-13546b018fa0",
                "encryption": "none"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "xhttp",
        "security": "tls",
        "tlsSettings": {
          "serverName": "cdn4.el-bot.com",
          "fingerprint": "firefox",
          "alpn": [
            "h2"
          ]
        },
        "xhttpSettings": {
          "host": "cdn4.el-bot.com",
          "path": "/p",
          "mode": "packet-up",
          "scMaxEachPostBytes": "262144-786432",
          "scMinPostsIntervalMs": "0",
          "seqKey": "offset",
          "seqPlacement": "query",
          "sessionIDKey": "sid",
          "sessionIDPlacement": "query",
          "sessionKey": "sid",
          "sessionPlacement": "query",
          "uplinkHTTPMethod": "GET",
          "xPaddingBytes": "48-256",
          "xPaddingKey": "q",
          "xPaddingMethod": "tokenish",
          "xPaddingObfsMode": true,
          "xPaddingPlacement": "query",
          "xmux": {
            "cMaxReuseTimes": 0,
            "hKeepAlivePeriod": 20,
            "hMaxRequestTimes": "600-900",
            "hMaxReusableSecs": "120-240",
            "maxConcurrency": "0",
            "maxConnections": "16-32"
          }
        }
      }
    },
    {
      "tag": "direct",
      "protocol": "freedom",
      "settings": {}
    },
    {
      "tag": "block",
      "protocol": "blackhole",
      "settings": {}
    }
  ],
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {
        "type": "field",
        "inboundTag": [
          "in-chain"
        ],
        "outboundTag": "SERVER-2-VMESS"
      }
    ]
  }
}
